{
  "expo": {
    "name": "КФБ Инвест",
    "slug": "sbis-mobile",
    "scheme": "sbis",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kg.sbis.mobile"
    },
    "android": {
      "package": "kg.sbis.mobile",
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "КФБ Инвест"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
