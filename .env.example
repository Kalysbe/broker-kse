APP_ENV=development
HTTP_ADDR=:18080
DATABASE_URL=postgres://sbis:sbis@localhost:15432/sbis?sslmode=disable
REDIS_URL=redis://localhost:16379/0
JWT_SECRET=replace-with-32-byte-secret-value-min
HMAC_PEPPER=replace-with-hmac-pepper
HMAC_REQUIRED=false
GATEWAY_DEV_TOKEN=sk_test_devStage1TokenDoNotUseInProd
OBJECT_STORE_DIR=/data/objects
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:15173,http://localhost:18000,http://localhost
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_EMAIL=admin@broker.local
SEED_ADMIN_PASSWORD=ChangeMe_Admin12
VITE_API_URL=http://localhost:18080
KFB_GATEWAY_URL=http://localhost:8080
KFB_GATEWAY_TOKEN=
# Shared outgoing request budget for API, worker and exchange load tests.
KFB_TRADING_RPS=20
KFB_READ_RPS=100
# Runtime bucket capacity for incoming broker gRPC realtime admission.
REALTIME_LIMIT_MAX_STATES=100000
# Native gateway subscription (mount CA/client certificate/private key read-only).
KFB_GRPC_TARGET=host.docker.internal:8443
KFB_GRPC_SERVER_NAME=localhost
KFB_GRPC_CA=/certs/ca.crt
KFB_GRPC_CERT=/certs/bridge.crt
KFB_GRPC_KEY=/certs/bridge.key
