# Android emulator reaches the Windows host at 10.0.2.2.
# Leave unset to select the platform-specific local development default.
# EXPO_PUBLIC_API_URL=http://10.0.2.2:18080
# For web: EXPO_PUBLIC_API_URL=http://127.0.0.1:18080
# Production must use your broker's HTTPS API origin.

# Development exchange: existing broker API -> test KFB on localhost:8080.
EXPO_PUBLIC_DATA_SOURCE=kfb
