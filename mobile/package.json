{
  "name": "sbis-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "node scripts/android.mjs run",
    "android:build": "node scripts/android.mjs build",
    "android:start": "node scripts/android.mjs start",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8082",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "preview": "node scripts/preview.mjs",
    "test": "node --experimental-strip-types --test src/domain/order.test.ts src/domain/format.test.ts src/api/client.test.ts src/updates/release.test.ts scripts/phone-config.test.mjs scripts/update-release.test.mjs",
    "update:prepare": "node scripts/prepare-update.mjs",
    "dev:backend": "node dev/start.mjs",
    "dev:seed": "node dev/setup.mjs",
    "test:integration": "node --experimental-strip-types --test dev/integration.test.ts",
    "backend:start": "node backend/start.mjs",
    "test:kfb": "node --experimental-strip-types backend/check.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.104.5",
    "decimal.js": "^10.6.0",
    "expo": "~58.0.16",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.17",
    "lucide-react-native": "^1.61.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
